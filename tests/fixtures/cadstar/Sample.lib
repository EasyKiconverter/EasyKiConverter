UNITS MM
PAD "P_RECT"
SHAPE RECTANGLE
WIDTH 1.0
HEIGHT 1.5
OFFSET 0.1 -0.2
ENDPAD
PAD "P_SLOT"
SHAPE OBLONG
WIDTH 2.0
HEIGHT 1.0
HOLE SLOT 0.6 1.2
ENDPAD
PACKAGE "PKG_TEST"
DESCRIPTION "Cadstar package fixture"
PIN "1"
POSITION (1.0 2.0)
ROTATION 90
PAD "P_RECT"
ENDPIN
PIN "2"
POSITION (3.0 2.0)
PAD "P_SLOT"
ENDPIN
RECT (0.0 0.0) (4.0 3.0) WIDTH 0.2
CIRCLE (2.0 1.5) RADIUS 1.0 WIDTH 0.15
POLYGON (0.0 0.0) (1.0 0.0) (1.0 1.0)
ENDPACKAGE
COMPONENT "SYM_TEST"
VERSION 54
PROPERTY REFDES U
PIN "1"
START (0.0 0.0)
END (100.0 0.0)
PINTYPE INPUT
NUMBERS [1:2]
LABEL "INPUT" (20.0 5.0) 1
ENDPIN
RECT (-10.0 -5.0) (10.0 5.0)
ENDCOMPONENT
PART "PART_TEST"
COMPONENT "SYM_TEST"
PACKAGE "PKG_TEST"
DESCRIPTION "Cadstar part fixture"
ENDPART
