(ACCEL_ASCII "Sample Board"
  (UNITS MM)
  (LIBRARY
    (PADSTYLEDEF "P1"
      (HOLEDIAM 0.8)
      (ISHOLEPLATED TRUE)
      (PADSHAPE ROUND (SHAPEWIDTH 1.6) (SHAPEHEIGHT 1.6))
    )
    (PADSTYLEDEF "P2"
      (PADSHAPE RECT (SHAPEWIDTH 2.0) (SHAPEHEIGHT 1.0))
    )
    (PATTERNDEF "PKG_TEST"
      (PAD (PADNUM 1) (PADSTYLEREF "P1") (PT 0 0) (ROTATION 0))
      (PAD (PADNUM 2) (PADSTYLEREF "P2") (PT 2 0) (ROTATION 900))
      (PATTERNGRAPHICS
        (LINE (PT -1 -1) (PT 3 -1) (WIDTH 0.2) (LAYERNUMREF 1))
        (POLY (PT -1 -1) (PT 3 -1) (PT 3 1) (PT -1 1) (LAYERNUMREF 1))
      )
    )
  )
  (PCBDESIGN
    (MULTILAYER
      (PATTERN (PATTERNREF "PKG_TEST") (REFDESREF "R1") (PT 10 20) (ROTATION 450) (ISFLIPPED FALSE))
    )
    (LAYERCONTENTS
      (CIRCLE (PT 10 20) (RADIUS 5) (WIDTH 0.2) (LAYERNUMREF 1))
    )
  )
)
